<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/styles.css">
    <title>Mini Message Board</title>
</head>
    <body>
        <h1>Add a new message</h1>
        <form method="post" action="/new">
            <label for="author">Your name:</label>
            <input name="author" type="text" id="author" placeholder="Bob..." required maxlength="20">

            <label for="message">Your message:</label>
            <textarea name="message" id="message" placeholder="Hello..." required maxlength="100"></textarea>

            <button class="submit-btn" type="submit">Send</button>
        </form>
        <a class="cancel-btn" href="/">Cancel</a>
    </body>
</html>